# Copia este archivo como .env y rellena los valores.
# El .env real NO se sube al repo (está en .gitignore).

# Clave de la API de Hevy (Ajustes > Developer en la web de Hevy)
HEVY_API_KEY=

# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Token que inventas tú y pones en el campo "encabezado de autorización"
# del webhook de Hevy como: Bearer <este valor>
WEBHOOK_AUTH_TOKEN=
